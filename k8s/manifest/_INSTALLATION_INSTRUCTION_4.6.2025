### Setup seaweedfs for RWX PVC ###
kubectl create ns seaweedfs
helm repo add seaweedfs https://seaweedfs.github.io/seaweedfs/helm
# remember to change the hostPathPrefix in volume
helm install -n seaweedfs seaweedfs seaweedfs/seaweedfs  -f seaweedfs-values.yaml --version 4.0.402
helm repo add seaweedfs-csi-driver https://seaweedfs.github.io/seaweedfs-csi-driver/helm
helm install -n seaweedfs seaweedfs-csi-driver seaweedfs-csi-driver/seaweedfs-csi-driver --set seaweedfsFiler=seaweedfs-filer.seaweedfs.svc:8888 --set mountService.enabled=true --version 0.2.3
# manual create PVs and PVCs that uses same path.
# DO NOT NEED to provision the nfs anymore
kubectl apply -f seaweedfs-skypilot-pv.yaml
kubectl apply -n skypilot -f seaweedfs-skypilot-pvc.yaml
kubectl apply -f seaweedfs-tokenvisor-pv.yaml
kubectl apply -n tokenvisor -f seaweedfs-tokenvisor-pvc.yaml


