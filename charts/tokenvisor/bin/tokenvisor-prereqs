platform_plan() {
  local include_grafana="$1"
  local include_fluent="$2"

  cat <<EOF
Platform will:
  - create namespaces: ${TOKENVISOR_NAMESPACE}, ${SKYPILOT_NAMESPACE}
  - apply Gateway API CRDs
  - create GatewayClass/cilium only when Cilium pods are detected and the class is missing
  - apply ServiceMonitor and PodMonitor CRDs
  - write operator values under .local/
  - install missing required operators:
      VictoriaMetrics Operator 0.62.1
      Dragonfly Operator v1.1.10
      ClickHouse Operator 0.27.0
      CloudNativePG 0.27.1
  - patch Dragonfly operator metrics binding to 0.0.0.0:8080 only on first install
EOF

  if [ "${include_grafana}" -eq 1 ]; then
    cat <<'EOF'
  - install missing optional Grafana Operator v5.17.0
EOF
  fi
  if [ "${include_fluent}" -eq 1 ]; then
    cat <<'EOF'
  - install missing optional Fluent Operator
EOF
  fi

  cat <<'EOF'
Run with --apply to execute.
EOF
}

run_platform() {
  local apply=0
  local assume_yes=0
  local include_grafana=0
  local include_fluent=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      --include-grafana)
        include_grafana=1
        ;;
      --include-fluent)
        include_fluent=1
        ;;
      *)
        die "unknown platform option: $1"
        ;;
    esac
    shift
  done

  if [ "${apply}" -ne 1 ]; then
    platform_plan "${include_grafana}" "${include_fluent}"
    return 0
  fi

  require_tool kubectl
  require_tool helm
  confirm_apply "platform prerequisites (CRDs/operators/namespaces)" "${assume_yes}"

  info "Creating required namespaces"
  apply_namespace "${TOKENVISOR_NAMESPACE}"
  apply_namespace "${SKYPILOT_NAMESPACE}"

  apply_gateway_api_crds
  ensure_cilium_gateway_class
  apply_monitoring_crds
  write_platform_values
  install_vm_operator
  install_dragonfly_operator
  install_clickhouse_operator
  install_cnpg_operator
  if [ "${include_grafana}" -eq 1 ]; then
    install_grafana_operator
  fi
  if [ "${include_fluent}" -eq 1 ]; then
    install_fluent_operator
  fi

  info "Platform phase completed. Run: ./bin/tokenvisor-prereqs check"
}

render_seaweedfs_model_storage() {
  local model_path="$1"
  local size="$2"
  local output="${LOCAL_DIR}/seaweedfs-model-storage.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
apiVersion: v1
kind: PersistentVolume
metadata:
  name: seaweedfs-tokenvisor-pv
spec:
  accessModes: [ReadWriteMany]
  capacity:
    storage: ${size}
  csi:
    driver: seaweedfs-csi-driver
    volumeHandle: seaweedfs-tokenvisor-pv-id
    volumeAttributes:
      collection: default
      path: $(yaml_quote "${model_path}")
      concurrentReaders: "128"
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nfs-model-storage-pvc
  namespace: ${TOKENVISOR_NAMESPACE}
spec:
  storageClassName: ""
  volumeName: seaweedfs-tokenvisor-pv
  accessModes: [ReadWriteMany]
  resources:
    requests:
      storage: ${size}
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: seaweedfs-skypilot-pv
spec:
  accessModes: [ReadWriteMany]
  capacity:
    storage: ${size}
  csi:
    driver: seaweedfs-csi-driver
    volumeHandle: seaweedfs-skypilot-pv-id
    volumeAttributes:
      collection: default
      path: $(yaml_quote "${model_path}")
      concurrentReaders: "128"
  persistentVolumeReclaimPolicy: Retain
  volumeMode: Filesystem
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nfs-model-storage-pvc
  namespace: ${SKYPILOT_NAMESPACE}
spec:
  storageClassName: ""
  volumeName: seaweedfs-skypilot-pv
  accessModes: [ReadWriteMany]
  resources:
    requests:
      storage: ${size}
YAML

  info "Wrote ${output}"
  warn "For SeaweedFS CSI static PVs, ${size} is Kubernetes binding metadata, not a hard storage quota."
}

run_storage_check() {
  local failed=0

  if check_audit_s3_values_file; then
    check_item "secret/emu-secret key EMU_AUDIT_S3_ACCESS_KEY" check_secret_key emu-secret EMU_AUDIT_S3_ACCESS_KEY || failed=1
    check_item "secret/emu-secret key EMU_AUDIT_S3_SECRET_KEY" check_secret_key emu-secret EMU_AUDIT_S3_SECRET_KEY || failed=1
    check_item "bundled SeaweedFS audit S3 infrastructure" check_bundled_seaweedfs_audit_s3 || failed=1
  else
    warn "audit S3 is not configured; set EMU_AUDIT_RECORD_MODE=off until it is ready"
  fi
  check_item "model PVC in ${TOKENVISOR_NAMESPACE}" check_model_pvc || failed=1
  check_item "model PVC in ${SKYPILOT_NAMESPACE}" check_skypilot_model_pvc || failed=1

  printf '\nOptional storage helpers:\n'
  check_optional_item "StorageClass/local-path" check_local_path_storage_class
  check_optional_item "SeaweedFS CSI driver" check_seaweedfs_csi_driver

  if [ "${failed}" -ne 0 ]; then
    cat <<EOF

See:
  docs/STORAGE.md
  docs/SEAWEEDFS.md

Notes:
  - This helper does not install OpenEBS.
  - Audit S3 readiness validates configuration, required Secrets, and bundled infrastructure.
  - It intentionally does not make an S3 object request; use an operational probe after deployment.
EOF
    die "storage check found missing prerequisites"
  fi
}

run_storage_local_path() {
  local apply=0
  local assume_yes=0
  local manifest_url="https://raw.githubusercontent.com/rancher/local-path-provisioner/v0.0.34/deploy/local-path-storage.yaml"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      *)
        die "unknown storage local-path option: $1"
        ;;
    esac
    shift
  done

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
Storage local-path will:
  - skip if StorageClass/local-path already exists
  - otherwise install Rancher local-path-provisioner v0.0.34
  - create StorageClass/local-path without marking it as default

Manifest:
  ${manifest_url}

Run with --apply to execute.
EOF
    return 0
  fi

  require_tool kubectl
  if kubectl_ok get storageclass local-path; then
    info "StorageClass/local-path already exists; skipping local-path-provisioner install"
    return 0
  fi

  confirm_apply "storage local-path prerequisites" "${assume_yes}"
  kubectl apply -f "${manifest_url}"
}

run_storage_model_pvcs() {
  local apply=0
  local assume_yes=0
  local model_path="/shared_hf_repo"
  local size="20Gi"
  local output="${LOCAL_DIR}/seaweedfs-model-storage.yaml"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      --path)
        shift
        [ -n "${1:-}" ] || die "--path requires a value"
        model_path="$1"
        ;;
      --size)
        shift
        [ -n "${1:-}" ] || die "--size requires a value"
        size="$1"
        ;;
      *)
        die "unknown storage model-pvcs option: $1"
        ;;
    esac
    shift
  done

  case "${model_path}" in
    /*) ;;
    *) die "--path must be an absolute SeaweedFS path" ;;
  esac

  render_seaweedfs_model_storage "${model_path}" "${size}"
  if [ "${apply}" -ne 1 ]; then
    info "Rendered ${output}. Run with --apply to create/update PVs and PVCs."
    return 0
  fi

  require_tool kubectl
  confirm_apply "storage model PV/PVC manifests" "${assume_yes}"
  apply_namespace "${TOKENVISOR_NAMESPACE}"
  apply_namespace "${SKYPILOT_NAMESPACE}"
  kubectl apply -f "${output}"
}

prompt_value() {
  local label="$1"
  local default_value="$2"
  local value

  [ -t 0 ] || die "interactive storage setup requires a terminal"
  printf '%s [%s]: ' "${label}" "${default_value}" >&2
  read -r value
  printf '%s' "${value:-${default_value}}"
}

prompt_secret() {
  local label="$1"
  local value

  [ -t 0 ] || die "interactive storage setup requires a terminal"
  printf '%s: ' "${label}" >&2
  read -rs value
  printf '\n' >&2
  [ -n "${value}" ] || die "${label} must not be empty"
  printf '%s' "${value}"
}

prompt_yes_no() {
  local label="$1"
  local answer

  [ -t 0 ] || die "interactive storage setup requires a terminal"
  while true; do
    printf '%s [y/N]: ' "${label}" >&2
    read -r answer
    case "${answer}" in
      y|Y|yes|YES)
        return 0
        ;;
      ""|n|N|no|NO)
        return 1
        ;;
      *)
        warn "Enter y or n."
        ;;
    esac
  done
}

discover_selectable_volume_nodes() {
  local -n nodes_ref="$1"
  local raw_nodes name ready unschedulable taint_effects

  require_tool kubectl
  raw_nodes="$(
    kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"|"}{.status.conditions[?(@.type=="Ready")].status}{"|"}{.spec.unschedulable}{"|"}{range .spec.taints[*]}{.effect}{","}{end}{"\n"}{end}'
  )" || die "failed to list Kubernetes nodes"

  nodes_ref=()
  while IFS='|' read -r name ready unschedulable taint_effects; do
    [ -n "${name}" ] || continue
    [ "${ready}" = "True" ] || continue
    [ "${unschedulable}" != "true" ] || continue
    case ",${taint_effects}," in
      *,NoSchedule,*|*,NoExecute,*) continue ;;
    esac
    nodes_ref+=("${name}")
  done <<< "${raw_nodes}"
}

select_volume_nodes() {
  local required_count="$1"
  local selection default_selection="" selected_nodes=""
  local index selected_index selection_position
  local -a available_nodes selected_indexes
  local -A seen_indexes=()

  discover_selectable_volume_nodes available_nodes
  [ "${#available_nodes[@]}" -ge "${required_count}" ] \
    || die "${required_count} volume-server pods require at least ${required_count} Ready nodes without cordons or hard scheduling taints; found ${#available_nodes[@]}"

  printf '\nAvailable Ready and schedulable volume nodes:\n' >&2
  for index in "${!available_nodes[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${available_nodes[index]}" >&2
  done
  printf '\n' >&2

  if [ "${#available_nodes[@]}" -eq "${required_count}" ]; then
    for ((index = 1; index <= required_count; index++)); do
      default_selection+="${default_selection:+,}${index}"
    done
    selection="$(
      prompt_value \
        "Select exactly ${required_count} volume nodes by number, comma-separated" \
        "${default_selection}"
    )"
  else
    [ -t 0 ] || die "interactive storage setup requires a terminal"
    printf 'Select exactly %d volume nodes by number, comma-separated: ' \
      "${required_count}" >&2
    read -r selection
  fi

  selection="${selection//[[:space:]]/}"
  [[ "${selection}" =~ ^[0-9]+(,[0-9]+)*$ ]] \
    || die "volume node selection must be comma-separated numbers"
  IFS=',' read -r -a selected_indexes <<< "${selection}"
  [ "${#selected_indexes[@]}" -eq "${required_count}" ] \
    || die "select exactly ${required_count} volume nodes"

  for selection_position in "${!selected_indexes[@]}"; do
    selected_index="${selected_indexes[selection_position]}"
    selected_index="$((10#${selected_index}))"
    selected_indexes[selection_position]="${selected_index}"
    [ "${selected_index}" -ge 1 ] \
      && [ "${selected_index}" -le "${#available_nodes[@]}" ] \
      || die "volume node selection ${selected_index} is out of range"
    [ -z "${seen_indexes[${selected_index}]+x}" ] \
      || die "volume node selection must not contain duplicates"
    seen_indexes["${selected_index}"]=1
    selected_nodes+="${selected_nodes:+ }${available_nodes[selected_index - 1]}"
  done

  printf '\nSelected volume nodes:\n' >&2
  for selected_index in "${selected_indexes[@]}"; do
    printf '  - %s\n' "${available_nodes[selected_index - 1]}" >&2
  done
  printf '%s' "${selected_nodes}"
}

validate_selected_volume_nodes() {
  local selected_nodes="$1"
  local required_count="$2"
  local node candidate found
  local -a available_nodes selected

  discover_selectable_volume_nodes available_nodes
  read -r -a selected <<< "${selected_nodes}"
  [ "${#selected[@]}" -eq "${required_count}" ] \
    || die "expected ${required_count} selected volume nodes; found ${#selected[@]}"

  for node in "${selected[@]}"; do
    found=0
    for candidate in "${available_nodes[@]}"; do
      if [ "${node}" = "${candidate}" ]; then
        found=1
        break
      fi
    done
    [ "${found}" -eq 1 ] \
      || die "selected volume node ${node} is no longer Ready and schedulable"
  done
}

normalise_host_paths() {
  local raw_paths="$1"
  local path normalised=""

  IFS=',' read -r -a paths <<< "${raw_paths}"
  for path in "${paths[@]}"; do
    path="$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "${path}")"
    [ -n "${path}" ] || die "host paths must not contain an empty entry"
    normalised+="${normalised:+,}${path}"
  done
  printf '%s' "${normalised}"
}

validate_unique_host_paths() {
  local paths="$1"
  local required_count="$2"
  local unique_count

  unique_count="$(tr ',' '\n' <<< "${paths}" | sort -u | wc -l | tr -d ' ')"
  [ "${unique_count}" -eq "${required_count}" ] \
    || die "each SeaweedFS data directory requires a distinct host path"
}

validate_positive_integer() {
  local label="$1"
  local value="$2"

  case "${value}" in
    ""|*[!0-9]*) die "${label} must be a positive integer" ;;
  esac
  [ "${value}" -ge 1 ] || die "${label} must be at least 1"
}

validate_s3_key_prefix() {
  local key_prefix="$1"

  printf '%s' "${key_prefix}" | grep -Eq '^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$' \
    || die "object key prefix may contain only letters, numbers, '-', '_', and slash-separated non-empty segments"
}

render_audit_s3_values() {
  local endpoint="$1"
  local bucket="$2"
  local region="$3"
  local key_prefix="$4"
  local output="${LOCAL_DIR}/audit-s3-values.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
# Generated by ./bin/tokenvisor-prereqs storage audit-s3.
# Include this file in the TokenVisor Helm install/upgrade command.
emu:
  config:
    EMU_AUDIT_S3_ENDPOINT_URL: $(yaml_quote "${endpoint}")
    EMU_AUDIT_S3_BUCKET: $(yaml_quote "${bucket}")
    EMU_AUDIT_S3_REGION: $(yaml_quote "${region}")
    EMU_AUDIT_S3_KEY_PREFIX: $(yaml_quote "${key_prefix}")
YAML
  info "Wrote ${output}"
}

render_audit_s3_secret() {
  local access_key="$1"
  local secret_key="$2"
  local output="${LOCAL_DIR}/audit-s3-secret.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
# Generated by ./bin/tokenvisor-prereqs storage audit-s3.
# Keep this file out of git. It is a JSON merge patch, not a Secret manifest.
# Applying this patch cannot replace unrelated emu-secret keys.
data:
  EMU_AUDIT_S3_ACCESS_KEY: $(base64_encode "${access_key}")
  EMU_AUDIT_S3_SECRET_KEY: $(base64_encode "${secret_key}")
YAML
  chmod 600 "${output}"
  info "Wrote ${output}"
}

render_seaweedfs_values() {
  local -n config="$1"
  local enable_s3="$2"
  local bucket="$3"
  local replication_placement="00$((config[data_copies] - 1))"
  local output="${LOCAL_DIR}/seaweedfs-values.yaml"
  local volume_data
  local volume_node_affinity=""
  local filer_s3=""
  local index node path
  local -a nodes paths

  if [ "${config[volume_mode]}" = "hostpath" ]; then
    volume_data=""
    index=1
    IFS=',' read -r -a paths <<< "${config[volume_paths]}"
    for path in "${paths[@]}"; do
      volume_data+="    - name: data${index}
      type: hostPath
      hostPathPrefix: $(yaml_quote "${path}")
      maxVolumes: 0
"
      index=$((index + 1))
    done
    read -r -a nodes <<< "${config[volume_nodes]}"
    volume_node_affinity="    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
"
    for node in "${nodes[@]}"; do
      volume_node_affinity+="          - matchFields:
              - key: metadata.name
                operator: In
                values:
                  - $(yaml_quote "${node}")
"
    done
  else
    volume_data=""
    for ((index = 1; index <= config[data_dir_count]; index++)); do
      volume_data+="    - name: data${index}
      type: persistentVolumeClaim
      size: $(yaml_quote "${config[volume_size]}")
      storageClass: $(yaml_quote "${config[volume_storage_class]}")
      maxVolumes: 0
"
    done
  fi

  if [ "${enable_s3}" -eq 1 ]; then
    filer_s3="  s3:
    enabled: true
    enableAuth: true
    existingConfigSecret: ${SEAWEEDFS_S3_CONFIG_SECRET}
    createBuckets:
      - name: $(yaml_quote "${bucket}")
        anonymousRead: false"
  fi

  ensure_local_dir
  cat > "${output}" <<YAML
# Generated by ./bin/tokenvisor-prereqs storage seaweedfs or bundled audit-s3.
# Keep SeaweedFS resource names aligned with the endpoints generated by this helper.
fullnameOverride: ${SEAWEEDFS_RELEASE}

global:
  seaweedfs:
    monitoring:
      enabled: true
    enableReplication: true
    replicationPlacement: "${replication_placement}"

master:
  replicas: 1
  data:
    type: persistentVolumeClaim
    size: $(yaml_quote "${config[master_size]}")
    storageClass: $(yaml_quote "${config[metadata_storage_class]}")
  logs:
    type: persistentVolumeClaim
    size: $(yaml_quote "${config[master_size]}")
    storageClass: $(yaml_quote "${config[metadata_storage_class]}")

volume:
  replicas: ${config[volume_server_count]}
  affinity: |
${volume_node_affinity}    podAntiAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: {{ template "seaweedfs.name" . }}
              app.kubernetes.io/instance: {{ .Release.Name }}
              app.kubernetes.io/component: volume
          topologyKey: kubernetes.io/hostname
  dataDirs:
${volume_data}

filer:
  replicas: 1
  data:
    type: persistentVolumeClaim
    size: $(yaml_quote "${config[filer_size]}")
    storageClass: $(yaml_quote "${config[metadata_storage_class]}")
  logs:
    type: persistentVolumeClaim
    size: $(yaml_quote "${config[filer_size]}")
    storageClass: $(yaml_quote "${config[metadata_storage_class]}")
${filer_s3}
YAML
  info "Wrote ${output}"
}

render_seaweedfs_s3_config_secret() {
  local access_key="$1"
  local secret_key="$2"
  local output="${LOCAL_DIR}/seaweedfs-s3-config-secret.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
# Generated by ./bin/tokenvisor-prereqs storage audit-s3.
# This helper-owned Secret gives SeaweedFS and EMU the same durable S3 credentials.
apiVersion: v1
kind: Secret
metadata:
  name: ${SEAWEEDFS_S3_CONFIG_SECRET}
  namespace: ${SEAWEEDFS_NAMESPACE}
type: Opaque
stringData:
  audit_access_key: $(yaml_quote "${access_key}")
  audit_secret_key: $(yaml_quote "${secret_key}")
  seaweedfs_s3_config: $(yaml_quote "{\"identities\":[{\"name\":\"tokenvisor-audit\",\"credentials\":[{\"accessKey\":\"${access_key}\",\"secretKey\":\"${secret_key}\"}],\"actions\":[\"Admin\",\"Read\",\"Write\"]}]}")
YAML
  chmod 600 "${output}"
  info "Wrote ${output}"
}

read_existing_seaweedfs_s3_credentials() {
  local encoded_access_key encoded_secret_key

  if kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_S3_CONFIG_SECRET}"; then
    encoded_access_key="$(kubectl -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_S3_CONFIG_SECRET}" -o 'jsonpath={.data.audit_access_key}')"
    encoded_secret_key="$(kubectl -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_S3_CONFIG_SECRET}" -o 'jsonpath={.data.audit_secret_key}')"
  else
    encoded_access_key="$(kubectl -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_RELEASE}-s3-secret" -o 'jsonpath={.data.admin_access_key_id}' 2>/dev/null || true)"
    encoded_secret_key="$(kubectl -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_RELEASE}-s3-secret" -o 'jsonpath={.data.admin_secret_access_key}' 2>/dev/null || true)"
  fi

  [ -n "${encoded_access_key}" ] && [ -n "${encoded_secret_key}" ] \
    || die "helper-managed SeaweedFS exists but its S3 credentials could not be recovered"
  printf '%s\n%s' "$(base64_decode "${encoded_access_key}")" "$(base64_decode "${encoded_secret_key}")"
}

render_seaweedfs_csi_values() {
  local output="${LOCAL_DIR}/seaweedfs-csi-values.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
# Generated by ./bin/tokenvisor-prereqs storage seaweedfs or bundled audit-s3.
seaweedfsFiler: "${SEAWEEDFS_RELEASE}-filer.${SEAWEEDFS_NAMESPACE}.svc.cluster.local:8888"
mountService:
  enabled: true
node:
  updateStrategy:
    type: OnDelete
YAML
  info "Wrote ${output}"
}

seaweedfs_prereq_marker_name() {
  printf '%s' "${SEAWEEDFS_RELEASE}-tokenvisor-prereq"
}

ensure_seaweedfs_storage_class() {
  local storage_class="$1"

  if kubectl_ok get storageclass "${storage_class}"; then
    return 0
  fi
  if [ "${storage_class}" = "local-path" ]; then
    info "StorageClass/local-path is missing; installing the helper-managed local-path provisioner"
    # The outer audit-s3 command already obtained one explicit confirmation.
    run_storage_local_path --apply --yes
    return 0
  fi
  die "StorageClass/${storage_class} was not found; create it before rerunning the storage command"
}

guard_existing_seaweedfs_values() {
  local output="${LOCAL_DIR}/seaweedfs-values.yaml"

  [ -f "${output}" ] || return 0
  warn "Existing SeaweedFS configuration found at ${output}."
  warn "This helper does not safely modify an existing SeaweedFS topology. Edit the file and apply Helm manually if you need a topology change."
  prompt_yes_no "Replace the existing generated SeaweedFS configuration" \
    || die "kept ${output}; no SeaweedFS configuration was changed"
}

prompt_seaweedfs_topology() {
  local -n config="$1"
  local index path default_path

  config[metadata_storage_class]="$(prompt_value "StorageClass for SeaweedFS master/filer metadata" "local-path")"
  config[master_size]="$(prompt_value "SeaweedFS master PVC size" "5Gi")"
  config[filer_size]="$(prompt_value "SeaweedFS filer PVC size" "25Gi")"
  info "Each volume-server pod requires a distinct schedulable Kubernetes node."
  config[volume_server_count]="$(prompt_value "Number of SeaweedFS volume-server pods (one per node)" "1")"
  validate_positive_integer "volume-server pod count" "${config[volume_server_count]}"
  config[volume_server_count]="$((10#${config[volume_server_count]}))"
  config[data_copies]="$(prompt_value "Number of copies for stored data (1, 2, or 3)" "1")"
  case "${config[data_copies]}" in
    1|2|3) ;;
    *) die "data copies must be 1, 2, or 3" ;;
  esac
  [ "${config[volume_server_count]}" -ge "${config[data_copies]}" ] \
    || die "${config[data_copies]} data copies require at least ${config[data_copies]} volume-server pods"
  config[data_dir_count]="$(prompt_value "Number of data directories per volume-server pod" "1")"
  validate_positive_integer "data-directory count" "${config[data_dir_count]}"
  config[data_dir_count]="$((10#${config[data_dir_count]}))"

  if prompt_yes_no "Use hostPath for SeaweedFS volume-server data"; then
    config[volume_mode]="hostpath"
    warn "Prepare and mount every backing filesystem before continuing. The helper pins volume-server pods to the selected nodes and configures host-path prefixes."
    config[volume_paths]=""
    for ((index = 1; index <= config[data_dir_count]; index++)); do
      if [ "${config[data_dir_count]}" -eq 1 ]; then
        default_path="/data/seaweedfs"
      else
        default_path="/data/seaweedfs-${index}"
      fi
      path="$(
        prompt_value \
          "Host-path prefix for data directory ${index} on every selected volume node" \
          "${default_path}"
      )"
      case "${path}" in *,*) die "a host path must not contain a comma" ;; esac
      path="$(normalise_host_paths "${path}")"
      case "${path}" in /*) ;; *) die "SeaweedFS host paths must be absolute" ;; esac
      case "${path}" in
        /) die "SeaweedFS host-path prefix must not be the filesystem root" ;;
        *[!a-zA-Z0-9_./-]*) die "SeaweedFS host-path prefixes may contain only letters, numbers, '/', '.', '_', and '-'" ;;
      esac
      while [ "${path%/}" != "${path}" ]; do
        path="${path%/}"
      done
      case "${path}/" in */../*) die "SeaweedFS host-path prefixes must not contain '..' segments" ;; esac
      config[volume_paths]+="${config[volume_paths]:+,}${path}"
    done
    validate_unique_host_paths "${config[volume_paths]}" "${config[data_dir_count]}"
    config[volume_nodes]="$(select_volume_nodes "${config[volume_server_count]}")"
    config[volume_storage_class]=""
    config[volume_size]=""
  else
    config[volume_mode]="pvc"
    config[volume_storage_class]="$(prompt_value "StorageClass for SeaweedFS volume-server data" "${config[metadata_storage_class]}")"
    config[volume_size]="$(prompt_value "PVC size for each volume-server data directory" "100Gi")"
    config[volume_paths]=""
    config[volume_nodes]=""
  fi
}

apply_bundled_seaweedfs() {
  local enable_s3="$1"
  local values_file="${LOCAL_DIR}/seaweedfs-values.yaml"
  local marker_name metadata_storage_class volume_mode volume_nodes volume_paths
  local volume_server_count volume_storage_class
  local -a volume_storage_classes

  require_tool kubectl
  require_tool helm
  require_yq_v4 "applying rendered SeaweedFS configuration"

  metadata_storage_class="$(yq eval -r '.master.data.storageClass // ""' "${values_file}")"
  [ -n "${metadata_storage_class}" ] \
    || die "rendered SeaweedFS configuration is missing the metadata StorageClass"
  volume_mode="$(
    yq eval -r '.volume.dataDirs[].type' "${values_file}" | sort -u
  )"
  volume_server_count="$(yq eval -r '.volume.replicas // 0' "${values_file}")"

  case "${volume_mode}" in
    hostPath)
      volume_nodes="$(
        yq eval -r \
          '.volume.affinity
            | from_yaml
            | [.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[]
              | .matchFields[]?
              | select(.key == "metadata.name")
              | .values[]]
            | join(" ")' \
          "${values_file}"
      )"
      [ -n "${volume_nodes}" ] \
        || die "rendered hostPath configuration does not contain explicit volume-node affinity; rerun storage setup without --apply"
      validate_selected_volume_nodes "${volume_nodes}" "${volume_server_count}"
      volume_paths="$(
        yq eval -r \
          '.volume.dataDirs | map(select(.type == "hostPath").hostPathPrefix) | join(",")' \
          "${values_file}"
      )"
      ;;
    persistentVolumeClaim)
      mapfile -t volume_storage_classes < <(
        yq eval -r \
          '.volume.dataDirs[]
            | select(.type == "persistentVolumeClaim")
            | .storageClass' \
          "${values_file}" \
          | sort -u
      )
      [ "${#volume_storage_classes[@]}" -gt 0 ] \
        || die "rendered SeaweedFS configuration is missing the volume-data StorageClass"
      ;;
    *)
      die "rendered SeaweedFS data directories must use one supported storage type"
      ;;
  esac

  ensure_seaweedfs_storage_class "${metadata_storage_class}"
  if [ "${volume_mode}" = "persistentVolumeClaim" ]; then
    for volume_storage_class in "${volume_storage_classes[@]}"; do
      [ -n "${volume_storage_class}" ] \
        || die "rendered SeaweedFS configuration contains an empty volume-data StorageClass"
      ensure_seaweedfs_storage_class "${volume_storage_class}"
    done
  fi

  marker_name="$(seaweedfs_prereq_marker_name)"
  if helm_release_exists "${SEAWEEDFS_RELEASE}" "${SEAWEEDFS_NAMESPACE}" \
    && ! kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get configmap "${marker_name}"; then
    die "SeaweedFS release ${SEAWEEDFS_RELEASE}/${SEAWEEDFS_NAMESPACE} already exists but is not helper-managed; review and reconcile it manually"
  fi
  if helm_release_exists seaweedfs-csi-driver "${SEAWEEDFS_NAMESPACE}" \
    && ! kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get configmap "${marker_name}"; then
    die "SeaweedFS CSI release already exists but is not helper-managed; review and reconcile it manually"
  fi

  apply_namespace "${SEAWEEDFS_NAMESPACE}"
  kubectl -n "${SEAWEEDFS_NAMESPACE}" create configmap "${marker_name}" \
    --from-literal=managed-by=tokenvisor-prereqs \
    --dry-run=client -o yaml | kubectl apply -f -
  if [ "${enable_s3}" -eq 1 ]; then
    kubectl apply -f "${LOCAL_DIR}/seaweedfs-s3-config-secret.yaml"
  fi
  if [ "${volume_mode}" = "hostPath" ]; then
    warn "Verify every configured host-path prefix (${volume_paths}) is an intended mounted filesystem on every selected node (${volume_nodes}); the chart stores data under <prefix>/object_store/."
  fi

  helm repo add seaweedfs https://seaweedfs.github.io/seaweedfs/helm --force-update
  helm repo add seaweedfs-csi-driver https://seaweedfs.github.io/seaweedfs-csi-driver/helm --force-update
  helm repo update seaweedfs seaweedfs-csi-driver
  helm upgrade --install "${SEAWEEDFS_RELEASE}" seaweedfs/seaweedfs \
    --namespace "${SEAWEEDFS_NAMESPACE}" \
    --create-namespace \
    --version "${SEAWEEDFS_CHART_VERSION}" \
    --timeout 15m \
    --wait \
    -f "${LOCAL_DIR}/seaweedfs-values.yaml"
  helm upgrade --install seaweedfs-csi-driver seaweedfs-csi-driver/seaweedfs-csi-driver \
    --namespace "${SEAWEEDFS_NAMESPACE}" \
    --version "${SEAWEEDFS_CSI_CHART_VERSION}" \
    --timeout 15m \
    --wait \
    -f "${LOCAL_DIR}/seaweedfs-csi-values.yaml"
}

apply_audit_s3_secret() {
  local output="${LOCAL_DIR}/audit-s3-secret.yaml"

  check_secret emu-secret || die "emu-secret is missing; run secrets apply before storage audit-s3 --apply"
  kubectl patch secret emu-secret \
    --namespace "${TOKENVISOR_NAMESPACE}" \
    --type merge \
    --patch-file "${output}"
}

validate_rendered_audit_s3() {
  check_audit_s3_values_file \
    && check_audit_s3_secret_file \
    || die "rendered audit S3 configuration is incomplete; rerun storage audit-s3 without --apply"

  if uses_bundled_audit_s3; then
    [ -f "${LOCAL_DIR}/seaweedfs-values.yaml" ] \
      && [ -f "${LOCAL_DIR}/seaweedfs-s3-config-secret.yaml" ] \
      && [ -f "${LOCAL_DIR}/seaweedfs-csi-values.yaml" ] \
      || die "rendered bundled SeaweedFS configuration is incomplete; rerun storage audit-s3 without --apply"
  fi
}

apply_rendered_audit_s3() {
  local assume_yes="$1"
  local access_key existing_credentials secret_key
  local bundled=0

  validate_rendered_audit_s3
  if uses_bundled_audit_s3; then
    bundled=1
    info "Reusing rendered bundled audit S3 and SeaweedFS configuration."
  else
    info "Reusing rendered external audit S3 configuration."
  fi

  require_tool kubectl
  check_secret emu-secret \
    || die "emu-secret is missing; run secrets apply before storage audit-s3 --apply"
  confirm_apply "audit S3 prerequisites" "${assume_yes}"
  apply_namespace "${TOKENVISOR_NAMESPACE}"

  if [ "${bundled}" -eq 1 ]; then
    require_tool helm
    if helm_release_exists "${SEAWEEDFS_RELEASE}" "${SEAWEEDFS_NAMESPACE}"; then
      warn "Existing SeaweedFS release detected: changing the default data-copy setting does not retrofit existing data."
      if kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_S3_CONFIG_SECRET}" \
        || kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_RELEASE}-s3-secret"; then
        existing_credentials="$(read_existing_seaweedfs_s3_credentials)"
        access_key="${existing_credentials%%$'\n'*}"
        secret_key="${existing_credentials#*$'\n'}"
        render_seaweedfs_s3_config_secret "${access_key}" "${secret_key}"
        render_audit_s3_secret "${access_key}" "${secret_key}"
      fi
    fi
    apply_bundled_seaweedfs 1
  fi

  apply_audit_s3_secret
  info "Audit S3 prerequisites applied. Build .local/deployed-values.yaml with the values build command in README.md."
}

run_storage_audit_s3() {
  local apply=0
  local assume_yes=0
  local endpoint bucket region key_prefix access_key secret_key
  local bundled=0
  local -A topology=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      *)
        die "unknown storage audit-s3 option: $1"
        ;;
    esac
    shift
  done

  if [ "${apply}" -eq 1 ] && audit_s3_rendered_files_exist; then
    apply_rendered_audit_s3 "${assume_yes}"
    return 0
  fi

  if prompt_yes_no "Use external S3-compatible storage"; then
    endpoint="$(prompt_value "S3 endpoint URL" "https://s3.example.com")"
    bucket="$(prompt_value "Audit bucket" "tokenvisor-audit")"
    region="$(prompt_value "S3 region" "us-east-1")"
    key_prefix="$(prompt_value "Object key prefix" "audit-media")"
    access_key="$(prompt_secret "S3 access key")"
    secret_key="$(prompt_secret "S3 secret key")"
  else
    bundled=1
    info "Bundled SeaweedFS installs an authenticated in-cluster S3 endpoint and its CSI driver."
    guard_existing_seaweedfs_values
    prompt_seaweedfs_topology topology
    bucket="$(prompt_value "Audit bucket" "tokenvisor-audit")"
    region="us-east-1"
    key_prefix="audit-media"
    access_key="$(random_hex)"
    secret_key="$(random_hex)"
    endpoint="http://${SEAWEEDFS_RELEASE}-s3.${SEAWEEDFS_NAMESPACE}.svc.cluster.local:8333"

    render_seaweedfs_values topology 1 "${bucket}"
    render_seaweedfs_s3_config_secret "${access_key}" "${secret_key}"
    render_seaweedfs_csi_values
  fi

  validate_s3_key_prefix "${key_prefix}"

  render_audit_s3_values "${endpoint}" "${bucket}" "${region}" "${key_prefix}"
  render_audit_s3_secret "${access_key}" "${secret_key}"

  if [ "${apply}" -ne 1 ]; then
    if [ "${bundled}" -eq 1 ]; then
      cat <<EOF
Bundled audit S3 configuration was rendered. To use it:
  1. Run this command again with --apply to install SeaweedFS ${SEAWEEDFS_CHART_VERSION}
     and its CSI driver ${SEAWEEDFS_CSI_CHART_VERSION}, then patch the audit S3 credentials.
  2. Build .local/deployed-values.yaml with the values build command in README.md.
EOF
    else
      cat <<'EOF'
External audit S3 configuration was rendered. To use it:
  1. Run this command again with --apply to patch the audit S3 credentials.
  2. Build .local/deployed-values.yaml with the values build command in README.md.
EOF
    fi
    return 0
  fi

  apply_rendered_audit_s3 "${assume_yes}"
}

run_storage_seaweedfs() {
  local apply=0
  local assume_yes=0
  local -A topology=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      *)
        die "unknown storage seaweedfs option: $1"
        ;;
    esac
    shift
  done

  if uses_bundled_audit_s3; then
    die "bundled audit S3 already uses this SeaweedFS release; storage seaweedfs would disable its S3 gateway"
  fi
  guard_existing_seaweedfs_values
  info "This installs SeaweedFS and its CSI driver for RWX model storage without enabling S3."
  prompt_seaweedfs_topology topology
  render_seaweedfs_values topology 0 ""
  render_seaweedfs_csi_values

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
SeaweedFS configuration was rendered. Run this command again with --apply to install
SeaweedFS ${SEAWEEDFS_CHART_VERSION} and its CSI driver ${SEAWEEDFS_CSI_CHART_VERSION}.
After installation, run storage model-pvcs separately to create RWX model claims.
EOF
    return 0
  fi

  require_tool kubectl
  confirm_apply "SeaweedFS and its CSI driver" "${assume_yes}"
  apply_bundled_seaweedfs 0
  info "SeaweedFS and its CSI driver are installed. Run storage model-pvcs if RWX model claims are needed."
}

run_storage() {
  local subcommand="${1:-}"
  shift || true

  case "${subcommand}" in
    check)
      run_storage_check "$@"
      ;;
    local-path)
      run_storage_local_path "$@"
      ;;
    audit-s3)
      run_storage_audit_s3 "$@"
      ;;
    seaweedfs)
      run_storage_seaweedfs "$@"
      ;;
    model-pvcs)
      run_storage_model_pvcs "$@"
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
Storage commands:
  ./bin/tokenvisor-prereqs storage check
  ./bin/tokenvisor-prereqs storage local-path [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage audit-s3 [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage seaweedfs [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage model-pvcs [--apply] [--yes] [--path PATH] [--size SIZE]

Notes:
  - OpenEBS is not installed by this helper.
  - audit-s3 configures external S3 or installs helper-managed bundled SeaweedFS + CSI.
  - seaweedfs installs SeaweedFS + CSI without enabling S3.
  - model-pvcs assumes SeaweedFS CSI is already installed.
EOF
      ;;
    *)
      die "unknown storage subcommand: ${subcommand}"
      ;;
  esac
}

list_nvidia_gpu_pods() {
  kubectl get pods -A \
    -o 'jsonpath={range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -E '/(gpu-operator|nvidia-gpu-operator|gpu-operator-node-feature-discovery|gpu-feature-discovery|nvidia-container-toolkit-daemonset|nvidia-cuda-validator|nvidia-dcgm-exporter|nvidia-device-plugin-daemonset|nvidia-mig-manager|nvidia-operator-validator)(-|$)' \
    || true
}

list_amd_gpu_pods() {
  kubectl get pods -A \
    -o 'jsonpath={range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\n"}{end}' 2>/dev/null \
    | grep -E '/(amd-gpu-operator|amd-device-plugin|amd-metrics-exporter)(-|$)' \
    || true
}

has_nvidia_gpu_pods() {
  [ -n "$(list_nvidia_gpu_pods)" ]
}

has_amd_gpu_pods() {
  [ -n "$(list_amd_gpu_pods)" ]
}

run_gpu_check() {
  local nvidia_pods
  local amd_pods

  [ "$#" -eq 0 ] || die "unknown gpu check option: $1"
  require_tool kubectl

  nvidia_pods="$(list_nvidia_gpu_pods)"
  if [ -n "${nvidia_pods}" ]; then
    printf "ok   NVIDIA GPU Operator/runtime pods detected\n"
    printf "%s\n" "${nvidia_pods}" | sed 's/^/     /'
  else
    printf "miss NVIDIA GPU Operator/runtime pods\n"
  fi

  amd_pods="$(list_amd_gpu_pods)"
  if [ -n "${amd_pods}" ]; then
    printf "ok   AMD GPU Operator/runtime pods detected\n"
    printf "%s\n" "${amd_pods}" | sed 's/^/     /'
  else
    printf "miss AMD GPU Operator/runtime pods\n"
  fi

  cat <<'EOF'

GPU setup is conditional. Install the vendor path only if SkyPilot will run GPU workloads on that GPU type.
See docs/GPU.md for node/runtime prerequisites.
EOF
}

run_gpu_nvidia() {
  local apply=0
  local assume_yes=0
  local namespace="${NVIDIA_GPU_NAMESPACE:-gpu-operator}"
  local release_name="gpu-operator"
  local existing_pods

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      --namespace)
        shift
        [ -n "${1:-}" ] || die "--namespace requires a value"
        namespace="$1"
        ;;
      *)
        die "unknown gpu nvidia option: $1"
        ;;
    esac
    shift
  done

  require_tool kubectl
  existing_pods="$(list_nvidia_gpu_pods)"
  if [ -n "${existing_pods}" ]; then
    info "NVIDIA GPU Operator/runtime pods already exist; skipping install."
    printf "%s\n" "${existing_pods}" | sed 's/^/  /'
    return 0
  fi

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
GPU NVIDIA will:
  - install NVIDIA GPU Operator with Helm release ${release_name}
  - use namespace ${namespace}
  - set driver.enabled=false
  - set toolkit.enabled=false
  - set migManager.enabled=false

This assumes NVIDIA drivers/runtime prerequisites are already handled by the node image or cluster distro.
Run with --apply to execute.
EOF
    return 0
  fi

  require_tool helm
  confirm_apply "NVIDIA GPU operator prerequisites" "${assume_yes}"
  helm repo add nvidia https://helm.ngc.nvidia.com/nvidia --force-update
  helm repo update nvidia
  helm upgrade --install "${release_name}" nvidia/gpu-operator \
    --namespace "${namespace}" \
    --create-namespace \
    --set driver.enabled=false \
    --set toolkit.enabled=false \
    --set migManager.enabled=false
}

render_amd_metrics_exporter_config() {
  local namespace="$1"

  cat <<YAML
apiVersion: v1
kind: ConfigMap
metadata:
  name: amd-metrics-exporter-config
  namespace: ${namespace}
data:
  config.json: |
    {
      "GPUConfig": {
        "Fields": [
          "GPU_PACKAGE_POWER",
          "GPU_JUNCTION_TEMPERATURE",
          "GPU_MEMORY_TEMPERATURE",
          "GPU_GFX_ACTIVITY",
          "GPU_UMC_ACTIVITY",
          "PCIE_SPEED",
          "PCIE_MAX_SPEED",
          "PCIE_BANDWIDTH",
          "GPU_ENERGY_CONSUMED",
          "GPU_CLOCK",
          "GPU_TOTAL_VRAM",
          "GPU_FREE_VRAM",
          "GPU_USED_VRAM"
        ],
        "Labels": [
          "GPU_UUID",
          "SERIAL_NUMBER",
          "GPU_ID",
          "CARD_SERIES",
          "CARD_MODEL",
          "CARD_VENDOR",
          "DRIVER_VERSION",
          "VBIOS_VERSION",
          "HOSTNAME"
        ]
      }
    }
YAML
}

write_amd_metrics_exporter_config() {
  local namespace="$1"
  local output="${LOCAL_DIR}/amd-metrics-exporter-config.yaml"

  ensure_local_dir
  render_amd_metrics_exporter_config "${namespace}" > "${output}"
  info "Wrote ${output}"
}

run_gpu_amd() {
  local apply=0
  local assume_yes=0
  local namespace="${AMD_GPU_NAMESPACE:-amd-gpu-operator}"
  local existing_pods
  local output="${LOCAL_DIR}/amd-metrics-exporter-config.yaml"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      --namespace)
        shift
        [ -n "${1:-}" ] || die "--namespace requires a value"
        namespace="$1"
        ;;
      *)
        die "unknown gpu amd option: $1"
        ;;
    esac
    shift
  done

  require_tool kubectl
  existing_pods="$(list_amd_gpu_pods)"
  if [ -n "${existing_pods}" ]; then
    info "AMD GPU Operator/runtime pods already exist; skipping install."
    printf "%s\n" "${existing_pods}" | sed 's/^/  /'
    return 0
  fi

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
GPU AMD will:
  - install cert-manager v1.17.2
  - create namespace ${namespace}
  - write and apply ${output}
  - install AMD GPU Operator with Helm release amd-gpu-operator
  - set deviceConfig.spec.testRunner.enable=true
  - set deviceConfig.spec.metricsExporter.config.name=amd-metrics-exporter-config

Run with --apply to execute.
EOF
    return 0
  fi

  require_tool helm
  confirm_apply "AMD GPU operator prerequisites" "${assume_yes}"
  write_amd_metrics_exporter_config "${namespace}"
  helm repo add jetstack https://charts.jetstack.io --force-update
  helm upgrade --install cert-manager jetstack/cert-manager \
    --namespace cert-manager \
    --create-namespace \
    --version v1.17.2 \
    --set crds.enabled=true

  apply_namespace "${namespace}"
  kubectl apply -f "${output}"

  helm repo add rocm https://rocm.github.io/gpu-operator --force-update
  helm repo update rocm
  helm upgrade --install amd-gpu-operator rocm/gpu-operator-charts \
    --namespace "${namespace}" \
    --set deviceConfig.spec.testRunner.enable=true \
    --set deviceConfig.spec.metricsExporter.config.name=amd-metrics-exporter-config
}

run_gpu() {
  local subcommand="${1:-}"
  shift || true

  case "${subcommand}" in
    check)
      run_gpu_check "$@"
      ;;
    nvidia)
      run_gpu_nvidia "$@"
      ;;
    amd)
      run_gpu_amd "$@"
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
GPU commands:
  ./bin/tokenvisor-prereqs gpu check
  ./bin/tokenvisor-prereqs gpu nvidia [--apply] [--yes] [--namespace NAMESPACE]
  ./bin/tokenvisor-prereqs gpu amd [--apply] [--yes] [--namespace NAMESPACE]

Notes:
  - GPU setup is conditional; use it only when SkyPilot will run GPU workloads.
  - NVIDIA install is skipped when NVIDIA GPU Operator/runtime pods already exist anywhere.
  - AMD install is skipped when AMD GPU Operator/runtime pods already exist anywhere.
EOF
      ;;
    *)
      die "unknown gpu subcommand: ${subcommand}"
      ;;
  esac
}

render_skypilot_values() {
  local storage_class="$1"
  local image="$2"
  local output="${LOCAL_DIR}/skypilot-values.yaml"

  ensure_local_dir
  cat > "${output}" <<YAML
apiService:
  image: ${image}
  config: |
    serve:
      controller:
        resources:
          cloud: kubernetes
          cpus: 4+
          disk_size: 50
        high_availability: true
    kubernetes:
      ports: podip
      high_availability:
        storage_class_name: ${storage_class}
  resources:
    requests:
      cpu: "4"
      memory: "8Gi"
  serveServerLog: false

storage:
  storageClassName: ${storage_class}

ingress:
  enabled: false

ingress-nginx:
  enabled: false
YAML

  info "Wrote ${output}"
}

run_skypilot() {
  local apply=0
  local assume_yes=0
  local namespace="${SKYPILOT_NAMESPACE}"
  local release_name="skypilot"
  local chart_version="0.12.0"
  local storage_class="openebs-three-replica"
  local image="ghcr.io/embeddedllm/skypilot:v0.12.0"
  local output="${LOCAL_DIR}/skypilot-values.yaml"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      --namespace)
        shift
        [ -n "${1:-}" ] || die "--namespace requires a value"
        namespace="$1"
        ;;
      --release)
        shift
        [ -n "${1:-}" ] || die "--release requires a value"
        release_name="$1"
        ;;
      --storage-class|--sc)
        shift
        [ -n "${1:-}" ] || die "--storage-class requires a value"
        storage_class="$1"
        ;;
      --image)
        shift
        [ -n "${1:-}" ] || die "--image requires a value"
        image="$1"
        ;;
      --version)
        shift
        [ -n "${1:-}" ] || die "--version requires a value"
        chart_version="$1"
        ;;
      *)
        die "unknown skypilot option: $1"
        ;;
    esac
    shift
  done

  render_skypilot_values "${storage_class}" "${image}"

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
SkyPilot will:
  - install upstream chart skypilot/skypilot version ${chart_version}
  - use Helm release ${release_name}
  - use namespace ${namespace}
  - use API image ${image}
  - use storage class ${storage_class}

Values:
  ${output}

Run with --apply to execute.
EOF
    return 0
  fi

  require_tool kubectl
  require_tool helm
  confirm_apply "SkyPilot prerequisites" "${assume_yes}"

  apply_namespace "${namespace}"

  if ! kubectl_ok get storageclass "${storage_class}"; then
    warn "StorageClass/${storage_class} was not found; SkyPilot PVCs may stay Pending"
  fi

  helm repo add skypilot https://helm.skypilot.co --force-update
  helm repo update skypilot
  helm upgrade --install "${release_name}" skypilot/skypilot \
    --namespace "${namespace}" \
    -f "${output}" \
    --version "${chart_version}"
}

run_create_namespaces() {
  require_tool kubectl

  case "${1:-}" in
    --apply)
      namespace_manifest "${TOKENVISOR_NAMESPACE}" | kubectl apply -f -
      namespace_manifest "${SKYPILOT_NAMESPACE}" | kubectl apply -f -
      ;;
    ""|--dry-run)
      namespace_manifest "${TOKENVISOR_NAMESPACE}"
      echo "---"
      namespace_manifest "${SKYPILOT_NAMESPACE}"
      warn "dry run only; pass --apply to create/update namespaces"
      ;;
    *)
      die "unknown create-namespaces option: $1"
      ;;
  esac
}

prompt_secret_value() {
  local label="$1"
  local default_value="$2"
  local value

  printf '%s [press Enter to use generated value]: ' "${label}" >&2
  read -rs value
  printf '\n' >&2
  if [ -z "${value}" ]; then
    value="${default_value}"
  fi
  printf '%s' "${value}"
}

prompt_optional_secret_value() {
  local label="$1"
  local value

  printf '%s [press Enter to skip]: ' "${label}" >&2
  read -r value
  printf '\n' >&2
  printf '%s' "${value}"
}

render_interactive_secrets() {
  local clickhouse_cluster_secret="$1"
  local clickhouse_user_password="$2"
  local clickhouse_readonly_password="$3"
  local emupg_password="$4"
  local vmuser_password="$5"
  local emu_service_key="$6"
  local studio_auth_secret="$7"
  local grafana_admin_password="$8"
  local openai_api_key="$9"
  local huggingface_api_key="${10}"
  local openrouter_api_key="${11}"
  local anthropic_api_key="${12}"
  local cerebras_api_key="${13}"
  local cohere_api_key="${14}"
  local gemini_api_key="${15}"
  local groq_api_key="${16}"
  local hyperbolic_api_key="${17}"
  local jina_ai_api_key="${18}"
  local sambanova_api_key="${19}"
  local together_ai_api_key="${20}"
  local voyage_api_key="${21}"
  local resend_api_key="${22}"
  local emupg_password_urlencoded

  emupg_password_urlencoded="$(url_percent_encode "${emupg_password}")"

  cat > "${SECRETS_FILE}" <<YAML
# TokenVisor secrets generated by:
#   ./bin/tokenvisor-prereqs secrets init --interactive
#
# Keep this file out of git.

apiVersion: v1
kind: Secret
metadata:
  name: clickhouse-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: Opaque
stringData:
  cluster_secret: $(yaml_quote "${clickhouse_cluster_secret}")
  db_user_password: $(yaml_quote "${clickhouse_user_password}")
  db_readonly_user_password: $(yaml_quote "${clickhouse_readonly_password}")
---
apiVersion: v1
kind: Secret
metadata:
  name: pg-emu-user-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: kubernetes.io/basic-auth
stringData:
  username: "emupg"
  password: $(yaml_quote "${emupg_password}")
---
apiVersion: v1
kind: Secret
metadata:
  name: vmuser-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: Opaque
stringData:
  password: $(yaml_quote "${vmuser_password}")
---
apiVersion: v1
kind: Secret
metadata:
  name: emu-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: Opaque
stringData:
  EMU_DB_PATH: $(yaml_quote "postgresql+psycopg://emupg:${emupg_password_urlencoded}@tokenvisor-pgbouncer.${TOKENVISOR_NAMESPACE}.svc.cluster.local:5432/emu")
  EMU_SERVICE_KEY: $(yaml_quote "${emu_service_key}")
  EMU_OPENAI_API_KEY: $(yaml_quote "${openai_api_key}")
  EMU_HUGGINGFACE_API_KEY: $(yaml_quote "${huggingface_api_key}")
  EMU_OPENROUTER_API_KEY: $(yaml_quote "${openrouter_api_key}")
  EMU_ANTHROPIC_API_KEY: $(yaml_quote "${anthropic_api_key}")
  EMU_CEREBRAS_API_KEY: $(yaml_quote "${cerebras_api_key}")
  EMU_COHERE_API_KEY: $(yaml_quote "${cohere_api_key}")
  EMU_GEMINI_API_KEY: $(yaml_quote "${gemini_api_key}")
  EMU_GROQ_API_KEY: $(yaml_quote "${groq_api_key}")
  EMU_HYPERBOLIC_API_KEY: $(yaml_quote "${hyperbolic_api_key}")
  EMU_JINA_AI_API_KEY: $(yaml_quote "${jina_ai_api_key}")
  EMU_SAMBANOVA_API_KEY: $(yaml_quote "${sambanova_api_key}")
  EMU_TOGETHER_AI_API_KEY: $(yaml_quote "${together_ai_api_key}")
  EMU_VOYAGE_API_KEY: $(yaml_quote "${voyage_api_key}")
  EMU_RESEND_API_KEY: $(yaml_quote "${resend_api_key}")
---
apiVersion: v1
kind: Secret
metadata:
  name: studio-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: Opaque
stringData:
  STUDIO_AUTH_SECRET: $(yaml_quote "${studio_auth_secret}")
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: ${TOKENVISOR_NAMESPACE}
type: Opaque
stringData:
  admin_password: $(yaml_quote "${grafana_admin_password}")
YAML
}

secrets_init_interactive() {
  local clickhouse_cluster_secret
  local clickhouse_user_password
  local clickhouse_readonly_password
  local emupg_password
  local vmuser_password
  local emu_service_key
  local studio_auth_secret
  local grafana_admin_password
  local openai_api_key=""
  local huggingface_api_key=""
  local openrouter_api_key=""
  local anthropic_api_key=""
  local cerebras_api_key=""
  local cohere_api_key=""
  local gemini_api_key=""
  local groq_api_key=""
  local hyperbolic_api_key=""
  local jina_ai_api_key=""
  local sambanova_api_key=""
  local together_ai_api_key=""
  local voyage_api_key=""
  local resend_api_key=""

  if [ ! -t 0 ]; then
    die "secrets init --interactive requires an interactive terminal"
  fi

  info "Generating required secrets for namespace ${TOKENVISOR_NAMESPACE}"
  info "Internal secret/password prompts are hidden, following standard password-entry practice."
  info "Press Enter at each internal prompt to use a generated value."

  clickhouse_cluster_secret="$(prompt_secret_value "ClickHouse cluster secret" "$(random_hex)")"
  clickhouse_user_password="$(prompt_secret_value "ClickHouse emuuser password" "$(random_hex)")"
  clickhouse_readonly_password="$(prompt_secret_value "ClickHouse readonly password" "$(random_hex)")"
  emupg_password="$(prompt_secret_value "Postgres emupg password" "$(random_hex)")"
  vmuser_password="$(prompt_secret_value "VictoriaMetrics vmuser password" "$(random_hex)")"
  emu_service_key="$(prompt_secret_value "EMU service key" "$(random_hex)")"
  studio_auth_secret="$(prompt_secret_value "Studio auth secret" "$(random_hex)")"
  grafana_admin_password="$(prompt_secret_value "Grafana admin password" "$(random_hex)")"

  info "Provider API keys are optional and visible while typing for paste verification. Press Enter to leave a key empty."
  openai_api_key="$(prompt_optional_secret_value "EMU_OPENAI_API_KEY")"
  huggingface_api_key="$(prompt_optional_secret_value "EMU_HUGGINGFACE_API_KEY")"
  openrouter_api_key="$(prompt_optional_secret_value "EMU_OPENROUTER_API_KEY")"
  anthropic_api_key="$(prompt_optional_secret_value "EMU_ANTHROPIC_API_KEY")"
  cerebras_api_key="$(prompt_optional_secret_value "EMU_CEREBRAS_API_KEY")"
  cohere_api_key="$(prompt_optional_secret_value "EMU_COHERE_API_KEY")"
  gemini_api_key="$(prompt_optional_secret_value "EMU_GEMINI_API_KEY")"
  groq_api_key="$(prompt_optional_secret_value "EMU_GROQ_API_KEY")"
  hyperbolic_api_key="$(prompt_optional_secret_value "EMU_HYPERBOLIC_API_KEY")"
  jina_ai_api_key="$(prompt_optional_secret_value "EMU_JINA_AI_API_KEY")"
  sambanova_api_key="$(prompt_optional_secret_value "EMU_SAMBANOVA_API_KEY")"
  together_ai_api_key="$(prompt_optional_secret_value "EMU_TOGETHER_AI_API_KEY")"
  voyage_api_key="$(prompt_optional_secret_value "EMU_VOYAGE_API_KEY")"
  resend_api_key="$(prompt_optional_secret_value "EMU_RESEND_API_KEY")"

  render_interactive_secrets \
    "${clickhouse_cluster_secret}" \
    "${clickhouse_user_password}" \
    "${clickhouse_readonly_password}" \
    "${emupg_password}" \
    "${vmuser_password}" \
    "${emu_service_key}" \
    "${studio_auth_secret}" \
    "${grafana_admin_password}" \
    "${openai_api_key}" \
    "${huggingface_api_key}" \
    "${openrouter_api_key}" \
    "${anthropic_api_key}" \
    "${cerebras_api_key}" \
    "${cohere_api_key}" \
    "${gemini_api_key}" \
    "${groq_api_key}" \
    "${hyperbolic_api_key}" \
    "${jina_ai_api_key}" \
    "${sambanova_api_key}" \
    "${together_ai_api_key}" \
    "${voyage_api_key}" \
    "${resend_api_key}"

  info "Wrote ${SECRETS_FILE}"
  info "Review it if needed, then run: ./bin/tokenvisor-prereqs secrets apply"
}

secrets_init() {
  local force=0
  local interactive=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force)
        force=1
        ;;
      --interactive|-i)
        interactive=1
        ;;
      *)
        die "unknown secrets init option: $1"
        ;;
    esac
    shift
  done

  ensure_local_dir
  if [ -f "${SECRETS_FILE}" ] && [ "${force}" -ne 1 ]; then
    die "${SECRETS_FILE} already exists; use --force to overwrite"
  fi

  if [ "${interactive}" -eq 1 ]; then
    secrets_init_interactive
    return 0
  fi

  sed \
    -e "s/namespace: tokenvisor/namespace: ${TOKENVISOR_NAMESPACE}/g" \
    -e "s/tokenvisor-pgbouncer.tokenvisor.svc/tokenvisor-pgbouncer.${TOKENVISOR_NAMESPACE}.svc/g" \
    "${CHART_DIR}/docs/SECRETS_TEMPLATE.yaml" > "${SECRETS_FILE}"
  info "Wrote ${SECRETS_FILE}"
  info "Edit it, then run: ./bin/tokenvisor-prereqs secrets apply"
}

secrets_apply() {
  require_tool kubectl
  [ -f "${SECRETS_FILE}" ] || die "missing ${SECRETS_FILE}; run: ./bin/tokenvisor-prereqs secrets init"

  if grep -q "CHANGE_ME_" "${SECRETS_FILE}"; then
    die "${SECRETS_FILE} still contains CHANGE_ME_ placeholders"
  fi

  apply_namespaces_from_manifest "${SECRETS_FILE}"
  kubectl apply -f "${SECRETS_FILE}"
}

secrets_ghcr() {
  local apply=0
  local assume_yes=0

  require_tool kubectl
  [ -n "${GHCR_USERNAME:-}" ] || die "GHCR_USERNAME is required"
  [ -n "${GHCR_TOKEN:-}" ] || die "GHCR_TOKEN is required"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply)
        apply=1
        ;;
      --yes|-y)
        assume_yes=1
        ;;
      --dry-run)
        apply=0
        ;;
      *)
        die "unknown secrets ghcr option: $1"
        ;;
    esac
    shift
  done

  if [ "${apply}" -ne 1 ]; then
    cat <<EOF
Secrets ghcr will:
  - create or update ${REGISTRY_SECRET_NAME} in namespace ${TOKENVISOR_NAMESPACE}
  - use registry server ${GHCR_SERVER}

Run with --apply to execute.
EOF
    return 0
  fi

  confirm_apply "GHCR pull secrets" "${assume_yes}"
  namespace_manifest "${TOKENVISOR_NAMESPACE}" | kubectl apply -f -

  info "Creating/updating ${REGISTRY_SECRET_NAME} in namespace ${TOKENVISOR_NAMESPACE}"
  kubectl create secret docker-registry "${REGISTRY_SECRET_NAME}" \
    --namespace "${TOKENVISOR_NAMESPACE}" \
    --docker-server "${GHCR_SERVER}" \
    --docker-username "${GHCR_USERNAME}" \
    --docker-password "${GHCR_TOKEN}" \
    --docker-email "${GHCR_EMAIL:-tokenvisor@example.invalid}" \
    --dry-run=client \
    -o yaml | kubectl apply -f -
}

run_secrets() {
  local subcommand="${1:-}"
  shift || true

  case "${subcommand}" in
    init)
      secrets_init "$@"
      ;;
    apply)
      secrets_apply "$@"
      ;;
    ghcr)
      secrets_ghcr "$@"
      ;;
    *)
      usage
      die "unknown secrets subcommand: ${subcommand:-<empty>}"
      ;;
  esac
}

main() {
  local command="${1:-}"
  shift || true

  case "${command}" in
    check)
      run_check "$@"
      ;;
    platform)
      run_platform "$@"
      ;;
    storage)
      run_storage "$@"
      ;;
    values)
      run_values "$@"
      ;;
    gpu)
      run_gpu "$@"
      ;;
    skypilot)
      run_skypilot "$@"
      ;;
    create-namespaces)
      run_create_namespaces "$@"
      ;;
    secrets)
      run_secrets "$@"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      usage
      die "unknown command: ${command}"
      ;;
  esac
}

main "$@"
