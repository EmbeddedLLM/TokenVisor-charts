#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHART_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOCAL_DIR="${CHART_DIR}/.local"
SECRETS_FILE="${LOCAL_DIR}/tokenvisor-secrets.yaml"
TOKENVISOR_NAMESPACE="${TOKENVISOR_NAMESPACE:-tokenvisor}"
SKYPILOT_NAMESPACE="${SKYPILOT_NAMESPACE:-skypilot}"
REGISTRY_SECRET_NAME="${REGISTRY_SECRET_NAME:-registry-secret}"
GHCR_SERVER="${GHCR_SERVER:-ghcr.io}"
TOKENVISOR_MODE="${TOKENVISOR_MODE:-ha}"
SEAWEEDFS_NAMESPACE="${SEAWEEDFS_NAMESPACE:-seaweedfs}"
SEAWEEDFS_RELEASE="${SEAWEEDFS_RELEASE:-seaweedfs}"
SEAWEEDFS_CHART_VERSION="${SEAWEEDFS_CHART_VERSION:-4.39.0}"
SEAWEEDFS_CSI_CHART_VERSION="${SEAWEEDFS_CSI_CHART_VERSION:-0.2.30}"
SEAWEEDFS_S3_CONFIG_SECRET="${SEAWEEDFS_S3_CONFIG_SECRET:-${SEAWEEDFS_RELEASE}-s3-config}"

usage() {
  cat <<'EOF'
Usage:
  ./bin/tokenvisor-prereqs check [--values PATH]
  ./bin/tokenvisor-prereqs platform [--apply] [--yes] [--include-grafana] [--include-fluent]
  ./bin/tokenvisor-prereqs storage check
  ./bin/tokenvisor-prereqs storage local-path [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage audit-s3 [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage seaweedfs [--apply] [--yes]
  ./bin/tokenvisor-prereqs storage model-pvcs [--apply] [--yes] [--path PATH] [--size SIZE]
  ./bin/tokenvisor-prereqs values build [--mode ha|single-node] [--output PATH] VALUES_FILE...
  ./bin/tokenvisor-prereqs gpu check
  ./bin/tokenvisor-prereqs gpu nvidia [--apply] [--yes] [--namespace NAMESPACE]
  ./bin/tokenvisor-prereqs gpu amd [--apply] [--yes] [--namespace NAMESPACE]
  ./bin/tokenvisor-prereqs skypilot [--apply] [--yes] [--storage-class NAME|--sc NAME] [--image IMAGE] [--version VERSION]
  ./bin/tokenvisor-prereqs create-namespaces [--apply]
  ./bin/tokenvisor-prereqs secrets init [--force] [--interactive]
  ./bin/tokenvisor-prereqs secrets apply
  ./bin/tokenvisor-prereqs secrets ghcr [--apply] [--yes]

Commands that mutate the cluster require --apply. Without --apply, commands review
the planned action or render local files only.

Environment:
  TOKENVISOR_NAMESPACE   TokenVisor namespace (default: tokenvisor)
  SKYPILOT_NAMESPACE     SkyPilot namespace (default: skypilot)
  TOKENVISOR_MODE        ha or single-node for values build and check (default: ha)
  SEAWEEDFS_NAMESPACE    Bundled SeaweedFS namespace (default: seaweedfs)
  SEAWEEDFS_RELEASE      Bundled SeaweedFS release name (default: seaweedfs)
  REGISTRY_SECRET_NAME   Image pull secret name (default: registry-secret)
  GHCR_USERNAME          GitHub username for secrets ghcr
  GHCR_TOKEN             GitHub token for secrets ghcr
  GHCR_EMAIL             Optional email for secrets ghcr
  NVIDIA_GPU_NAMESPACE   NVIDIA GPU Operator namespace (default: gpu-operator)
  AMD_GPU_NAMESPACE      AMD GPU Operator namespace (default: amd-gpu-operator)
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

info() {
  echo "==> $*"
}

warn() {
  echo "WARN: $*" >&2
}

random_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
    return 0
  fi
  od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
}

yaml_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "${value}"
}

base64_encode() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

base64_decode() {
  printf '%s' "$1" | base64 --decode
}

require_yq_v4() {
  local operation="$1"
  local yq_version

  require_tool yq
  yq_version="$(yq --version 2>/dev/null || true)"
  case "${yq_version}" in
    *github.com/mikefarah/yq/*"version v4."*) ;;
    *)
      die "${operation} requires mikefarah/yq v4: https://github.com/mikefarah/yq#install"
      ;;
  esac
}

require_yq_merge_support() {
  require_yq_v4 "values build"
}

url_percent_encode() {
  local value="$1"
  local encoded=""
  local i char
  local LC_ALL=C

  for ((i = 0; i < ${#value}; i++)); do
    char="${value:i:1}"
    case "${char}" in
      [a-zA-Z0-9.~_-])
        encoded+="${char}"
        ;;
      *)
        printf -v encoded '%s%%%02X' "${encoded}" "'${char}"
        ;;
    esac
  done

  printf '%s' "${encoded}"
}

current_context() {
  kubectl config current-context 2>/dev/null || echo unknown
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ensure_local_dir() {
  mkdir -p "${LOCAL_DIR}"
}

run_values_build() {
  local mode="${TOKENVISOR_MODE}"
  local output="${LOCAL_DIR}/deployed-values.yaml"
  local output_dir
  local temporary_output
  local values_file
  local -a values_files=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --mode)
        [ "$#" -ge 2 ] || die "values build --mode requires ha or single-node"
        mode="$2"
        shift
        ;;
      --output)
        [ "$#" -ge 2 ] || die "values build --output requires a path"
        output="$2"
        shift
        ;;
      -h|--help)
        cat <<'EOF'
Usage:
  ./bin/tokenvisor-prereqs values build [--mode ha|single-node] [--output PATH] VALUES_FILE...

The files are merged in argument order, with later values taking precedence.
Single-node mode prepends the chart's values.single-node.yaml. The default output
is .local/deployed-values.yaml.
EOF
        return 0
        ;;
      --)
        shift
        values_files+=("$@")
        break
        ;;
      -*)
        die "unknown values build option: $1"
        ;;
      *)
        values_files+=("$1")
        ;;
    esac
    shift
  done

  case "${mode}" in
    ha) ;;
    single-node)
      values_files=("${CHART_DIR}/values.single-node.yaml" "${values_files[@]}")
      ;;
    *)
      die "values build --mode must be ha or single-node"
      ;;
  esac

  [ "${#values_files[@]}" -gt 0 ] || die "values build requires at least one values file"
  for values_file in "${values_files[@]}"; do
    [ -f "${values_file}" ] || die "values file not found: ${values_file}"
    [ "${values_file}" != "${output}" ] \
      || die "the output file cannot also be a values build input: ${output}"
  done

  require_yq_merge_support
  output_dir="$(dirname "${output}")"
  mkdir -p "${output_dir}"
  temporary_output="$(mktemp "${output}.XXXXXX")"

  info "Building ${output} for ${mode} mode from:"
  printf '  %s\n' "${values_files[@]}"
  if ! yq eval-all '. as $item ireduce ({}; . * $item)' \
    "${values_files[@]}" > "${temporary_output}"; then
    rm -f "${temporary_output}"
    die "failed to merge deployment values"
  fi
  mv "${temporary_output}" "${output}"
  info "Wrote ${output}"
}

run_values() {
  local subcommand="${1:-}"
  shift || true

  case "${subcommand}" in
    build)
      run_values_build "$@"
      ;;
    ""|help|-h|--help)
      cat <<'EOF'
Values commands:
  ./bin/tokenvisor-prereqs values build [--mode ha|single-node] [--output PATH] VALUES_FILE...
EOF
      ;;
    *)
      die "unknown values subcommand: ${subcommand}"
      ;;
  esac
}

kubectl_ok() {
  kubectl "$@" >/dev/null 2>&1
}

helm_release_exists() {
  local release_name="$1"
  local namespace="$2"

  helm status "${release_name}" -n "${namespace}" >/dev/null 2>&1
}

check_item() {
  local label="$1"
  shift

  if "$@"; then
    printf "ok   %s\n" "${label}"
  else
    printf "miss %s\n" "${label}"
    return 1
  fi
}

check_optional_item() {
  local label="$1"
  shift

  if "$@"; then
    printf "ok   %s (optional)\n" "${label}"
  else
    printf "miss %s (optional)\n" "${label}"
  fi
}

check_tool_item() {
  command -v "$1" >/dev/null 2>&1
}

check_crd() {
  kubectl_ok get crd "$1"
}

check_namespace() {
  kubectl_ok get namespace "$1"
}

check_secret() {
  kubectl_ok -n "${TOKENVISOR_NAMESPACE}" get secret "$1"
}

check_secret_key() {
  local secret_name="$1"
  local key="$2"

  kubectl get secret "${secret_name}" \
    -n "${TOKENVISOR_NAMESPACE}" \
    -o "jsonpath={.data.${key}}" 2>/dev/null | grep -q .
}

check_registry_secret() {
  kubectl_ok -n "$1" get secret "${REGISTRY_SECRET_NAME}"
}

check_model_pvc() {
  kubectl_ok -n "${TOKENVISOR_NAMESPACE}" get pvc nfs-model-storage-pvc
}

check_skypilot_model_pvc() {
  kubectl_ok -n "${SKYPILOT_NAMESPACE}" get pvc nfs-model-storage-pvc
}

check_seaweedfs_csi_driver() {
  kubectl_ok get csidriver seaweedfs-csi-driver
}

check_audit_s3_values_file() {
  local values_file="${1:-${LOCAL_DIR}/audit-s3-values.yaml}"

  [ -f "${values_file}" ] \
    && grep -Eq '^    EMU_AUDIT_S3_ENDPOINT_URL: ".+"$' "${values_file}" \
    && grep -Eq '^    EMU_AUDIT_S3_BUCKET: ".+"$' "${values_file}" \
    && grep -Eq '^    EMU_AUDIT_S3_REGION: ".+"$' "${values_file}" \
    && grep -Eq '^    EMU_AUDIT_S3_KEY_PREFIX: ".*"$' "${values_file}"
}

check_audit_s3_secret_file() {
  local secret_file="${1:-${LOCAL_DIR}/audit-s3-secret.yaml}"

  [ -f "${secret_file}" ] \
    && grep -Eq '^  EMU_AUDIT_S3_ACCESS_KEY: .+$' "${secret_file}" \
    && grep -Eq '^  EMU_AUDIT_S3_SECRET_KEY: .+$' "${secret_file}"
}

audit_s3_rendered_files_exist() {
  [ -e "${LOCAL_DIR}/audit-s3-values.yaml" ] \
    || [ -e "${LOCAL_DIR}/audit-s3-secret.yaml" ]
}

audit_s3_endpoint() {
  local values_file="${1:-${LOCAL_DIR}/audit-s3-values.yaml}"

  sed -n 's/^    EMU_AUDIT_S3_ENDPOINT_URL: "\(.*\)"$/\1/p' "${values_file}"
}

uses_bundled_audit_s3() {
  local values_file="${1:-${LOCAL_DIR}/audit-s3-values.yaml}"

  [ -f "${values_file}" ] || return 1
  [ "$(audit_s3_endpoint "${values_file}")" = \
    "http://${SEAWEEDFS_RELEASE}-s3.${SEAWEEDFS_NAMESPACE}.svc.cluster.local:8333" ]
}

check_bundled_seaweedfs_audit_s3() {
  local endpoint
  local values_file="${1:-${LOCAL_DIR}/audit-s3-values.yaml}"

  endpoint="$(audit_s3_endpoint "${values_file}")"
  case "${endpoint}" in
    "http://${SEAWEEDFS_RELEASE}-s3.${SEAWEEDFS_NAMESPACE}.svc.cluster.local:8333")
      kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get configmap "$(seaweedfs_prereq_marker_name)" \
        && kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get service "${SEAWEEDFS_RELEASE}-s3" \
        && kubectl_ok -n "${SEAWEEDFS_NAMESPACE}" get secret "${SEAWEEDFS_S3_CONFIG_SECRET}"
      ;;
    *)
      return 0
      ;;
  esac
}

check_local_path_storage_class() {
  kubectl_ok get storageclass local-path
}

check_skypilot_service() {
  kubectl_ok -n "${SKYPILOT_NAMESPACE}" get service skypilot-api-service
}

check_grafana_secret() {
  check_secret_key grafana-secret admin_password
}

check_chart_dependency() {
  compgen -G "${CHART_DIR}/charts/victoria-logs-single*" >/dev/null
}

check_deployed_values_file() {
  [ -s "$1" ]
}

check_mode() {
  case "${TOKENVISOR_MODE}" in
    ha|single-node)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

check_node_count() {
  local min_nodes=3
  local count

  case "${TOKENVISOR_MODE}" in
    ha)
      min_nodes=3
      ;;
    single-node)
      min_nodes=1
      ;;
    *)
      return 1
      ;;
  esac

  count="$(kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')"
  [ "${count:-0}" -ge "${min_nodes}" ]
}

check_ha_mode() {
  [ "${TOKENVISOR_MODE}" = "ha" ]
}

confirm_apply() {
  local description="$1"
  local assume_yes="$2"
  local context
  local answer

  context="$(current_context)"
  info "Kubernetes context: ${context}"

  if [ "${assume_yes}" -eq 1 ]; then
    return 0
  fi

  if [ ! -t 0 ]; then
    die "${description} mutates the cluster; rerun with --yes in non-interactive environments"
  fi

  printf 'Apply %s to context "%s"? Type "yes" to continue: ' "${description}" "${context}" >&2
  read -r answer
  if [ "${answer}" != "yes" ]; then
    info "No changes applied."
    exit 0
  fi
}

run_check() {
  local chart_dir_quoted
  local failed=0
  local values_file="${LOCAL_DIR}/deployed-values.yaml"
  local values_file_quoted

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --values)
        [ "$#" -ge 2 ] || die "check --values requires a path"
        values_file="$2"
        shift
        ;;
      *)
        die "unknown check option: $1"
        ;;
    esac
    shift
  done

  check_item "kubectl command" check_tool_item kubectl || failed=1
  check_item "helm command" check_tool_item helm || failed=1
  check_item "TOKENVISOR_MODE is ha or single-node" check_mode || failed=1
  check_item "victoria-logs-single chart dependency" check_chart_dependency || failed=1
  check_item "deployment values ${values_file}" \
    check_deployed_values_file "${values_file}" || failed=1

  if command -v kubectl >/dev/null 2>&1; then
    info "Kubernetes context: $(kubectl config current-context 2>/dev/null || echo unknown)"
    check_item "node count for ${TOKENVISOR_MODE} mode" check_node_count || failed=1
    check_item "namespace/${TOKENVISOR_NAMESPACE}" check_namespace "${TOKENVISOR_NAMESPACE}" || failed=1
    check_item "namespace/${SKYPILOT_NAMESPACE}" check_namespace "${SKYPILOT_NAMESPACE}" || failed=1
    check_item "Gateway API GatewayClass CRD" check_crd gatewayclasses.gateway.networking.k8s.io || failed=1
    check_item "Gateway API Gateway CRD" check_crd gateways.gateway.networking.k8s.io || failed=1
    check_item "Gateway API HTTPRoute CRD" check_crd httproutes.gateway.networking.k8s.io || failed=1
    check_item "GatewayClass/cilium" kubectl_ok get gatewayclass cilium || failed=1

    check_item "ServiceMonitor CRD" check_crd servicemonitors.monitoring.coreos.com || failed=1
    check_item "PodMonitor CRD" check_crd podmonitors.monitoring.coreos.com || failed=1
    check_item "VictoriaMetrics VMAgent CRD" check_crd vmagents.operator.victoriametrics.com || failed=1
    check_item "VictoriaMetrics VMAuth CRD" check_crd vmauths.operator.victoriametrics.com || failed=1
    check_item "VictoriaMetrics VMCluster CRD" check_crd vmclusters.operator.victoriametrics.com || failed=1
    check_item "VictoriaMetrics VMUser CRD" check_crd vmusers.operator.victoriametrics.com || failed=1
    check_item "VictoriaMetrics VMNodeScrape CRD" check_crd vmnodescrapes.operator.victoriametrics.com || failed=1
    check_item "VictoriaMetrics VMPodScrape CRD" check_crd vmpodscrapes.operator.victoriametrics.com || failed=1
    check_item "Dragonfly CRD" check_crd dragonflies.dragonflydb.io || failed=1
    check_item "ClickHouseInstallation CRD" check_crd clickhouseinstallations.clickhouse.altinity.com || failed=1
    if check_ha_mode; then
      check_item "ClickHouseKeeperInstallation CRD" check_crd clickhousekeeperinstallations.clickhouse-keeper.altinity.com || failed=1
    fi
    check_item "CNPG ImageCatalog CRD" check_crd imagecatalogs.postgresql.cnpg.io || failed=1
    check_item "CNPG Cluster CRD" check_crd clusters.postgresql.cnpg.io || failed=1
    check_item "CNPG Pooler CRD" check_crd poolers.postgresql.cnpg.io || failed=1

    check_item "model PVC nfs-model-storage-pvc" check_model_pvc || failed=1
    check_item "secret/clickhouse-secret" check_secret clickhouse-secret || failed=1
    check_item "secret/clickhouse-secret key cluster_secret" check_secret_key clickhouse-secret cluster_secret || failed=1
    check_item "secret/clickhouse-secret key db_user_password" check_secret_key clickhouse-secret db_user_password || failed=1
    check_item "secret/clickhouse-secret key db_readonly_user_password" check_secret_key clickhouse-secret db_readonly_user_password || failed=1
    check_item "secret/pg-emu-user-secret" check_secret pg-emu-user-secret || failed=1
    check_item "secret/pg-emu-user-secret key username" check_secret_key pg-emu-user-secret username || failed=1
    check_item "secret/pg-emu-user-secret key password" check_secret_key pg-emu-user-secret password || failed=1
    check_item "secret/vmuser-secret" check_secret vmuser-secret || failed=1
    check_item "secret/vmuser-secret key password" check_secret_key vmuser-secret password || failed=1
    check_item "secret/emu-secret" check_secret emu-secret || failed=1
    check_item "secret/emu-secret key EMU_DB_PATH" check_secret_key emu-secret EMU_DB_PATH || failed=1
    check_item "secret/emu-secret key EMU_SERVICE_KEY" check_secret_key emu-secret EMU_SERVICE_KEY || failed=1
    if check_audit_s3_values_file "${values_file}"; then
      check_item "secret/emu-secret key EMU_AUDIT_S3_ACCESS_KEY" check_secret_key emu-secret EMU_AUDIT_S3_ACCESS_KEY || failed=1
      check_item "secret/emu-secret key EMU_AUDIT_S3_SECRET_KEY" check_secret_key emu-secret EMU_AUDIT_S3_SECRET_KEY || failed=1
      check_item "bundled SeaweedFS audit S3 infrastructure" \
        check_bundled_seaweedfs_audit_s3 "${values_file}" || failed=1
    else
      warn "audit S3 is not configured; set EMU_AUDIT_RECORD_MODE=off until it is ready"
    fi
    check_item "secret/studio-secret" check_secret studio-secret || failed=1
    check_item "secret/studio-secret key STUDIO_AUTH_SECRET" check_secret_key studio-secret STUDIO_AUTH_SECRET || failed=1
    check_item "GHCR pull secret in ${TOKENVISOR_NAMESPACE}" check_registry_secret "${TOKENVISOR_NAMESPACE}" || failed=1
    check_item "SkyPilot API service" check_skypilot_service || failed=1

    printf '\nOptional:\n'
    check_optional_item "StorageClass/local-path" check_local_path_storage_class
    check_optional_item "SeaweedFS CSI driver" check_seaweedfs_csi_driver
    check_optional_item "model PVC in ${SKYPILOT_NAMESPACE}" check_skypilot_model_pvc
    check_optional_item "Grafana Operator CRD" check_crd grafanas.grafana.integreatly.org
    check_optional_item "Grafana admin secret" check_grafana_secret
    check_optional_item "Fluent Bit CRD" check_crd fluentbits.fluentbit.fluent.io
    check_optional_item "FluentBit ClusterInput CRD" check_crd clusterinputs.fluentbit.fluent.io
    check_optional_item "FluentBit ClusterFilter CRD" check_crd clusterfilters.fluentbit.fluent.io
    check_optional_item "FluentBit ClusterOutput CRD" check_crd clusteroutputs.fluentbit.fluent.io
    check_optional_item "FluentBit ClusterFluentBitConfig CRD" check_crd clusterfluentbitconfigs.fluentbit.fluent.io
    check_optional_item "NVIDIA GPU Operator/runtime pods" has_nvidia_gpu_pods
    check_optional_item "AMD GPU Operator/runtime pods" has_amd_gpu_pods
  fi

  if [ "${failed}" -ne 0 ]; then
    cat <<EOF

See:
  README.md
  docs/OPERATORS.md
  docs/STORAGE.md
  docs/SECRETS.md
  docs/SKYPILOT.md
EOF
    die "preflight check found missing prerequisites"
  fi

  printf -v chart_dir_quoted '%q' "${CHART_DIR}"
  printf -v values_file_quoted '%q' "${values_file}"
  cat <<EOF

Ready to install or upgrade TokenVisor:
  helm upgrade --install tokenvisor ${chart_dir_quoted} \\
    --namespace ${TOKENVISOR_NAMESPACE} \\
    --create-namespace \\
    -f ${values_file_quoted}
EOF
}

namespace_manifest() {
  local namespace="$1"
  kubectl create namespace "${namespace}" --dry-run=client -o yaml
}

apply_namespace() {
  namespace_manifest "$1" | kubectl apply -f -
}

apply_namespaces_from_manifest() {
  local manifest="$1"
  local namespace

  while IFS= read -r namespace; do
    [ -n "${namespace}" ] || continue
    apply_namespace "${namespace}"
  done < <(
    kubectl apply \
      --dry-run=client \
      -f "${manifest}" \
      -o 'jsonpath={.metadata.namespace}{"\n"}{range .items[*]}{.metadata.namespace}{"\n"}{end}' \
      | sed '/^$/d' \
      | sort -u
  )
}

apply_gateway_api_crds() {
  info "Applying Gateway API CRDs"
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/standard/gateway.networking.k8s.io_gatewayclasses.yaml
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/standard/gateway.networking.k8s.io_gateways.yaml
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/standard/gateway.networking.k8s.io_httproutes.yaml
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/standard/gateway.networking.k8s.io_referencegrants.yaml
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/standard/gateway.networking.k8s.io_grpcroutes.yaml
  kubectl apply -f https://raw.githubusercontent.com/kubernetes-sigs/gateway-api/v1.2.0/config/crd/experimental/gateway.networking.k8s.io_tlsroutes.yaml
}

ensure_cilium_gateway_class() {
  if kubectl_ok get gatewayclass cilium; then
    info "GatewayClass/cilium already exists"
    return 0
  fi

  if ! kubectl -n kube-system get pods -l k8s-app=cilium --no-headers 2>/dev/null | grep -q .; then
    warn "Cilium pods were not detected; skipping GatewayClass/cilium creation"
    warn "Install/enable Cilium Gateway support, then create GatewayClass/cilium if needed"
    return 0
  fi

  info "Creating GatewayClass/cilium"
  kubectl apply -f - <<'YAML'
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: cilium
spec:
  controllerName: io.cilium/gateway-controller
YAML
}

apply_monitoring_crds() {
  info "Applying ServiceMonitor/PodMonitor CRDs"
  kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.87.1/example/prometheus-operator-crd/monitoring.coreos.com_servicemonitors.yaml
  kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.87.1/example/prometheus-operator-crd/monitoring.coreos.com_podmonitors.yaml
  # https://github.com/VictoriaMetrics/helm-charts/issues/2838
  kubectl apply --server-side -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.87.1/example/prometheus-operator-crd/monitoring.coreos.com_scrapeconfigs.yaml
  kubectl apply --server-side -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.87.1/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
}

write_platform_values() {
  ensure_local_dir

  cat > "${LOCAL_DIR}/vm-operator-values.yaml" <<'YAML'
replicaCount: 1
crds:
  cleanup:
    enabled: true
serviceMonitor:
  enabled: true
  extraLabels:
    scrape-by: vmagent
resources:
  limits:
    cpu: 500m
    memory: 500Mi
  requests:
    cpu: 100m
    memory: 150Mi
YAML

  cat > "${LOCAL_DIR}/dragonfly-operator-values.yaml" <<'YAML'
replicaCount: 1
manager:
  resources:
    requests:
      cpu: 100m
      memory: 200Mi
    limits:
      cpu: 1000m
      memory: 2000Mi
serviceMonitor:
  enabled: true
  labels:
    scrape-by: vmagent
grafanaDashboard:
  enabled: true
  folder: dragonfly
  annotations:
    name: dragonfly_folder
  labels:
    name: dragonfly_dashboard
YAML

  cat > "${LOCAL_DIR}/clickhouse-operator-values.yaml" <<YAML
configs:
  files:
    config.yaml:
      watch:
        namespaces:
          - ${TOKENVISOR_NAMESPACE}
serviceMonitor:
  enabled: true
  additionalLabels:
    scrape-by: vmagent
dashboards:
  enabled: true
  additionalLabels:
    grafana_dashboard: "clickhouse"
  annotations: {}
  grafana_folder: clickhouse
YAML

  cat > "${LOCAL_DIR}/cnpg-operator-values.yaml" <<'YAML'
replicaCount: 1
config:
  data:
    INHERITED_LABELS: app.kubernetes.io/*
monitoring:
  podMonitorEnabled: true
  podMonitorAdditionalLabels:
    scrape-by: vmagent
  grafanaDashboard:
    create: true
YAML

  cat > "${LOCAL_DIR}/grafana-operator-values.yaml" <<'YAML'
serviceMonitor:
  enabled: true
  additionalLabels:
    scrape-by: vmagent
dashboard:
  enabled: true
YAML
}

install_vm_operator() {
  info "Installing VictoriaMetrics operator"
  apply_namespace vm-operator-system

  if helm_release_exists vmoperator vm-operator-system; then
    info "VictoriaMetrics operator release already exists; skipping install"
    return 0
  fi

  helm repo add vm https://victoriametrics.github.io/helm-charts/ --force-update
  helm repo update vm
  helm install vmoperator vm/victoria-metrics-operator \
    -f "${LOCAL_DIR}/vm-operator-values.yaml" \
    -n vm-operator-system \
    --set serviceMonitor.enabled=false \
    --version 0.62.1
  helm upgrade vmoperator vm/victoria-metrics-operator \
    -f "${LOCAL_DIR}/vm-operator-values.yaml" \
    -n vm-operator-system \
    --version 0.62.1
}

install_dragonfly_operator() {
  info "Installing Dragonfly operator"
  apply_namespace dragonfly-operator-system

  if helm_release_exists dragonfly-operator dragonfly-operator-system; then
    info "Dragonfly operator release already exists; skipping install"
    return 0
  fi

  helm upgrade --install dragonfly-operator \
    oci://ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator \
    -f "${LOCAL_DIR}/dragonfly-operator-values.yaml" \
    -n dragonfly-operator-system \
    --version v1.1.10

  info "Patching Dragonfly operator metrics bind address"
  if kubectl patch deployment dragonfly-operator \
    -n dragonfly-operator-system \
    --type='json' \
    -p='[
      {
        "op": "replace",
        "path": "/spec/template/spec/containers/1/args/1",
        "value": "--metrics-bind-address=0.0.0.0:8080"
      }
    ]'; then
    info "Dragonfly operator metrics patch applied"
  else
    warn "Dragonfly operator metrics patch failed; inspect deployment args manually"
  fi
}

install_clickhouse_operator() {
  info "Installing ClickHouse operator"
  apply_namespace clickhouse-operator-system

  if helm_release_exists clickhouse-operator clickhouse-operator-system; then
    info "ClickHouse operator release already exists; skipping install"
    return 0
  fi

  helm repo add clickhouse-operator https://docs.altinity.com/clickhouse-operator/ --force-update
  helm repo update clickhouse-operator
  helm upgrade --install clickhouse-operator \
    clickhouse-operator/altinity-clickhouse-operator \
    -f "${LOCAL_DIR}/clickhouse-operator-values.yaml" \
    -n clickhouse-operator-system \
    --version 0.27.0
}

